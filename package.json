{
  "name": "difrag",
  "version": "1.0.0",
  "description": "دیفرگ — نرم‌افزار انبارگردانی آفلاین",
  "main": "electron/main.js",
  "author": "Difrag Team",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --config renderer/vite.config.ts\" \"wait-on http://localhost:5173 && electron .\"",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "build": "npm run build:renderer && electron-builder --win --config build/electron-builder.yml",
    "postinstall": "electron-builder install-app-deps || true",
    "start": "electron ."
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "pino": "^9.5.0",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
